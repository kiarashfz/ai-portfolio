# Copy to .env and replace placeholder values. Never commit the populated file.
SERVICE_NAME=PortfolioGPT
ENVIRONMENT=local
API_SERVICE_PREFIX=
LOGGER_CONSOLE_ENABLED=true
LOGGER_HTTP_ENABLED=false
FLUENTBIT_ENDPOINT=http://localhost:9880

# Primary application database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Legacy secondary client is still constructed at startup.
# It can point to the same local PostgreSQL database.
POSTGRES_COMMERCE_DB=portfolio
POSTGRES_COMMERCE_USER=portfolio
POSTGRES_COMMERCE_PASSWORD=change-me
POSTGRES_COMMERCE_HOST=localhost
POSTGRES_COMMERCE_PORT=5432

REDIS_URL=redis://localhost:6379
REDIS_NODES=[]
REDIS_USER=default
REDIS_PASSWORD=
REDIS_PREFIX=portfoliogpt

# Local MinIO defaults match backend/docker-compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=portfolio
MINIO_REGION=us-east-1
UPLOAD_BASE_PATH=uploads
CDN_BASE_PATH=http://localhost:9000/portfolio

# OpenAI-compatible chat and embedding services; use your own provider values.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL_NAME=replace-with-chat-model
AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_EMBEDDING_API_KEY=replace-with-your-api-key
AI_EMBEDDING_MODEL_NAME=replace-with-embedding-model

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=portfolio_embeddings

# Legacy integrations: currently required by Settings even when unused.
LDAP_ENDPOINT=ldap://localhost:389
ENM_ENDPOINT=http://localhost
ENM_USERNAME=
ENM_PASSWORD=
ENM_NOTIFICATION_CODE=
SEARCHIA_BASE_ENDPOINT=http://localhost
SEARCHIA_API_KEY=unused-local-placeholder
SEARCHIA_INDEX_NAME=portfolio
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
